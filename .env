# Backend API base URL — must match the running Spring Boot backend.
# Both src/data/api.js and src/admin/adminApi.js read this. Without it,
# they fall back to different default URLs and the app breaks.
VITE_API_BASE_URL=http://localhost:8080

# WhatsApp order number in international format, no + or spaces
